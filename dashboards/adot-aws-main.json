    {
      "type": "log",
      "x": 0,
      "y": 20,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Recent spans (aws/spans, service main)",
        "region": "eu-west-1",
        "view": "table",
        "query": "SOURCE 'aws/spans'\n| fields @timestamp, name, durationNano, attributes.method, attributes.uri, attributes.outcome\n| filter resource.attributes.service.name = \"main\" or isempty(resource.attributes.service.name)\n| sort @timestamp desc\n| limit 20"
      }
    }
