{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "## adot-aws lab — CloudWatch metrics\nNamespace **`ICMTracing/Temporal`**, application / service **`main`** (data from the lab run before renaming `service.name`). Traces: Transaction Search / `aws/spans`."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "HTTP server requests (main)",
        "region": "eu-west-1",
        "period": 60,
        "stat": "Sum",
        "view": "timeSeries",
        "stacked": false,
        "yAxis": { "left": { "label": "count", "min": 0 } },
        "metrics": [
          [
            {
              "expression": "SEARCH('{ICMTracing/Temporal,exception,method,application,error,lab,uri,outcome,status} application=\"main\" MetricName=\"http.server.requests\"', 'Sum', 60)",
              "id": "http_req",
              "label": "http.server.requests",
              "region": "eu-west-1"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 12,
      "height": 6,
