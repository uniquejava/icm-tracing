# Copy to .env:
#   cp .env.example .env
#
# Collector-less lab (adot-direct): scripts/run-app-direct.sh reads AWS_PROFILE /
# AWS_REGION and runs `aws configure export-credentials` for SigV4 to X-Ray OTLP.
# Do NOT put long-lived keys here. Do not commit .env.

AWS_REGION=eu-west-1
AWS_PROFILE=default
