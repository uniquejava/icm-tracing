# Copy to .env:
#   cp .env.example .env
#
# ./scripts/startup.sh reads AWS_PROFILE / AWS_REGION, runs
# `aws configure export-credentials`, and passes session keys into the ADOT
# container. Do NOT put long-lived keys here. Do not commit .env.

AWS_REGION=eu-west-1
AWS_PROFILE=default

# App OTLP endpoints (defaults match docker-compose ADOT collector)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
