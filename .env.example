# Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Docker Compose reads .env automatically when starting the collector.
NR_ENDPOINT=https://otlp.nr-data.net:4317
MY_NEW_RELIC_API_KEY=your_new_relic_license_key

# Datadog (site: us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com | ...)
DD_SITE=ap1.datadoghq.com
DD_API_KEY=your_datadog_api_key
